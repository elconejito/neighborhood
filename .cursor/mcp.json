{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "stitch": {
            "command": "npx",
            "args": [
                "@_davideast/stitch-mcp",
                "proxy"
            ]
        }
    }
}
